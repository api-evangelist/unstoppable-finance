        {
          "info": {
            "name": "Get customer spending limit usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.iron.xyz/api/customers/:id/spending-limit",
            "headers": [
              {
                "name": "X-SUB-PARTNER-ID",
