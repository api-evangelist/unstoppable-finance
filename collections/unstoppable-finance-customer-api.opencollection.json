        {
          "info": {
            "name": "Get the pending authentication code for an entity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.iron.xyz/api/authentication-codes/entity/:id",
            "headers": [
              {
                "name": "X-SUB-PARTNER-ID",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the entity to get the pending authentication code for"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get the pending authentication code for an entity by ID\ne.g. ID of Autoramp or FiatAddress (entity in AuhorizationRequired state)\nif no pending code is found, retry flow will have to be triggered\n"
        },
        {
          "info": {
            "name": "Submit an authentication code",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.sandbox.iron.xyz/api/authentication-codes/:id",
            "headers": [
              {
                "name": "X-SUB-PARTNER-ID",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the authentication code to submit"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Submit the code for a given authentication\n"
        },
        {
          "info": {
            "name": "Get all Customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.iron.xyz/api/customers",
            "headers": [
              {
                "name": "X-SUB-PARTNER-ID",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Paging: the cursor field from previous page"
              },
              {
                "name": "prev_cursor",
                "value": "",
                "type": "query",
                "description": "Paging: the cursor field for backward pagination"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Paging: the requested page size (max 100)"
              },
              {
                "name": "search_term",
                "value": "",
                "type": "query",
                "description": "A search term to filter the customers"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by customer status (comma-separated or repeated values)"
              },
              {
                "name": "identification_status",
                "value": "",
                "type": "query",
                "description": "Filter by the customer's most-recent identification status"
              },
              {
                "name": "customer_type",
                "value": "",
                "type": "query",
                "description": "Filter by customer type (Person or Business)"
              },
              {
                "name": "has_transactions",
                "value": "",
                "type": "query",
                "description": "When true, only customers with at least one transaction; when\nfalse, only customers without any. Omit to disable the filter."
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Sort order: \"asc\" for oldest first, \"desc\" for newest first (default)"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get all customers for a particular partner. The partner ID does not need to be provided as it\nis provided by the API Key.\n\nAn optional `search_term` can be provided to filter by name, id, email, or external id.\n"
        },
