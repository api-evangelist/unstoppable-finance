                "name": "X-API-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new fiat transaction directly from an autoramp configuration for testing purposes.\nThis bypasses the normal deposit flow and creates a ramp transaction with the specified amount\nusing the autoramp's configuration (customer, recipient, currencies, etc.)."
        },
