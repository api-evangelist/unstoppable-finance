        {
          "info": {
            "name": "Reset sandbox environment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.iron.xyz/api/sandbox/reset",
            "headers": [
              {
                "name": "IDEMPOTENCY-KEY",
                "value": ""
              },
              {
                "name": "X-SUB-PARTNER-ID",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
