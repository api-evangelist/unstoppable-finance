{
  "opencollection": "1.0.0",
  "info": {
    "name": "Iron API - Sandbox Addresses Webhooks API",
    "version": "1.0-16988"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.iron.xyz/api/webhooks",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Paging: the cursor field from previous page"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Paging: the requested page size (max 100)"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Lists all webhooks for the currently authenticated partner\n"
        },
        {
          "info": {
            "name": "Update a webhook",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.sandbox.iron.xyz/api/webhooks/:id",
            "headers": [
              {
                "name": "X-SUB-PARTNER-ID",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the webhook to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Updates an existing webhook for the currently authenticated partner\n"
        },
        {
          "info": {
            "name": "Ping webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.iron.xyz/api/webhooks/:id/ping",
            "headers": [
              {
                "name": "IDEMPOTENCY-KEY",
                "value": ""
              },
              {
                "name": "X-SUB-PARTNER-ID",
                "value": ""
              },
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "the ID of the webhook to ping"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Sends a test ping event to a webhook for testing purposes"
        }
      ]
    }
  ],
  "bundled": true
}