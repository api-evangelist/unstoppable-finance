{
  "opencollection": "1.0.0",
  "info": {
    "name": "Iron API - Sandbox Addresses Currencies API",
    "version": "1.0-16988"
  },
  "items": [
    {
      "info": {
        "name": "Currencies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all available crypto currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.iron.xyz/api/cryptocurrencies",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "A list of all crypto currencies which are currently supported by Iron\n"
        },
        {
          "info": {
            "name": "List all available fiat currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.iron.xyz/api/fiatcurrencies",
            "headers": [
              {
                "name": "X-API-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "A list of all fiat currencies which are currently supported by Iron\n"
        }
      ]
    }
  ],
  "bundled": true
}